// Questo indirizzo cambierà quando caricherai il server su Render o Railway
const API_URL = "http://localhost:3000/api"; 

async function caricaPost() {
    const response = await fetch(`${API_URL}/posts`);
    const posts = await response.json();
    
    const feed = document.getElementById('feed');
    feed.innerHTML = ''; // Pulisce il feed

    posts.forEach(post => {
        const postElement = `
            <div class="post">
                <div class="header">
                    <img src="${post.profiles.avatar_url}" />
                    <b>${post.profiles.username}</b>
                </div>
                <p>${post.content}</p>
                <button onclick="mettiLike(${post.id})">❤️ Mi piace</button>
            </div>
        `;
        feed.innerHTML += postElement;
    });
}

async function inviaPost() {
    const testo = document.getElementById('testoPost').value;
    const utenteId = localStorage.getItem('userId'); // Assumendo che l'utente sia loggato

    await fetch(`${API_URL}/posts`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: testo, user_id: utenteId })
    });
    
    document.getElementById('testoPost').value = '';
    caricaPost(); // Aggiorna la lista
}
